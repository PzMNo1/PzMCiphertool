+                input?.focus();
+                return;
+            }
+            if (button.disabled) return;
+            button.disabled = true;
+            try {
+                await ctx.actions.postDashboard('invites/apply', { code });
+                await ctx.actions.loadDashboard({ message: '邀请码已绑定，邀请关系已更新' });
