+
+    async function copyText(root, ctx, value, label) {
+        if (!value) {
+            ctx.actions.toast(`${label}尚未生成`);
+            return;
+        }
+        try {
+            await navigator.clipboard.writeText(value);
+            ctx.actions.toast(`已复制${label}`);
